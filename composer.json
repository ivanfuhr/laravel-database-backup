{
    "name": "ivanfuhr/laravel-database-backup",
    "description": "Database backup and restore for Laravel with pluggable strategies (PostgreSQL included).",
    "keywords": [
        "php",
        "laravel",
        "package",
        "database",
        "backup",
        "restore",
        "postgresql",
        "pg_dump"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ivan Führ",
            "email": "dev.ivanfuhr@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3.0",
        "illuminate/console": "^11.44.2|^12.52.0|^13.0",
        "illuminate/contracts": "^11.44.2|^12.52.0|^13.0",
        "illuminate/filesystem": "^11.44.2|^12.52.0|^13.0",
        "illuminate/support": "^11.44.2|^12.52.0|^13.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "laravel/framework": "^11.44.2|^12.52.0|^13.0",
        "laravel/pint": "^1.29.0",
        "orchestra/testbench": "^9.0|^10.9.0|^11.1",
        "pestphp/pest": "^3.8.5|^4.6.2",
        "pestphp/pest-plugin-laravel": "^3.2.0|^4.0.0",
        "phpstan/phpstan": "^2.1.50",
        "rector/rector": "^2.4.2",
        "testcontainers/testcontainers": "^1.0.10"
    },
    "autoload": {
        "psr-4": {
            "IvanFuhr\\LaravelDatabaseBackup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "refactor": "rector",
        "lint": "pint --parallel",
        "test:refactor": "rector --dry-run",
        "test:lint": "pint --parallel --test",
        "test:types": "phpstan analyse --ansi --memory-limit=512M",
        "test:unit": "pest --colors=always --parallel --exclude-group=integration",
        "test:integration": "pest --colors=always --group=integration",
        "test:all-tests": "pest --colors=always",
        "test": [
            "@test:refactor",
            "@test:lint",
            "@test:types",
            "@test:all-tests"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "IvanFuhr\\LaravelDatabaseBackup\\DatabaseBackupServiceProvider"
            ]
        }
    }
}
